// Copy to secrets.h (gitignored) and fill in your channel's real values.
#pragma once

#include <stdint.h>
#include <stddef.h>

// Meshtastic channel to transmit on.
static const char    MESH_CHANNEL_NAME[] = "YourChannel";

// 16-byte PSK => AES128-CTR. (32 bytes would select AES256.)
static const uint8_t MESH_CHANNEL_PSK[]  = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};
static const size_t  MESH_CHANNEL_PSK_LEN = sizeof(MESH_CHANNEL_PSK);

// This node's number (the 32-bit "from" field in the packet header).
static const uint32_t MESH_NODE_NUM = 0x00000000;
